import os
import tempfile
import numpy as np

from eval.harness import (
    compute_recall_at_k,
    measure_query_time,
    measure_index_size,
)

from fvecs_loader import load_fvecs, load_ivecs

from method.PQ import PQ
from method.IVF import IVF
from method.PQ_IVF import IVFPQ


# =================================================
# Load SIFT1M
# =================================================

PROJECT_ROOT = os.path.dirname(
    os.path.dirname(
        os.path.abspath(__file__)
    )
)

sift_dir = os.path.join(PROJECT_ROOT, "sift")

base_path = os.path.join(sift_dir, "sift_base.fvecs")
query_path = os.path.join(sift_dir, "sift_query.fvecs")
learn_path = os.path.join(sift_dir, "sift_learn.fvecs")
groundtruth_path = os.path.join(
    sift_dir,
    "sift_groundtruth.ivecs",
)

# Load full SIFT1M data
sift_base = load_fvecs(base_path)
sift_query = load_fvecs(query_path)
sift_learn = load_fvecs(learn_path)
sift_groundtruth = load_ivecs(groundtruth_path)

print("SIFT base shape:        ", sift_base.shape)
print("SIFT query shape:       ", sift_query.shape)
print("SIFT learn shape:       ", sift_learn.shape)
print("SIFT groundtruth shape: ", sift_groundtruth.shape)


# =================================================
# Full SIFT1M benchmark data
# =================================================

# All 1,000,000 database vectors
base = sift_base

# All 10,000 query vectors
queries = sift_query

# All 100,000 dedicated training vectors
train = sift_learn

# SIFT ground truth contains the top 100 neighbours.
# We only need the first 10 for recall@10.
ground_truth = sift_groundtruth[:, :10]


# =================================================
# Helper function for index size
# =================================================

def get_index_size(model, suffix=".index"):
    """
    Temporarily save an ANN index to disk,
    measure its size using the shared harness,
    then delete the temporary file.
    """

    with tempfile.NamedTemporaryFile(
        suffix=suffix,
        delete=False,
    ) as tmp:
        tmp_path = tmp.name

    try:
        model.save(tmp_path)
        size_mb = measure_index_size(tmp_path)

    finally:
        os.remove(tmp_path)

    return size_mb


# =================================================
# 1. PQ
# =================================================

print("\n========== PQ ==========")

pq = PQ(
    m=8,
    nbits=8,
)

pq.build_index(
    base,
    train_vectors=train,
)

pq_results = []


def pq_timed_search(query):
    ids = pq.search(query, k=10)
    pq_results.append(ids)
    return ids


_, pq_avg_time_sec = measure_query_time(
    pq_timed_search,
    queries,
)

pq_recall = compute_recall_at_k(
    pq_results,
    ground_truth,
    k=10,
)

pq_index_size = get_index_size(pq)

print("PQ recall@10:      ", pq_recall)
print("PQ avg query time: ", pq_avg_time_sec * 1000, "ms")
print("PQ index size:     ", pq_index_size, "MB")


# =================================================
# 2. IVF
# =================================================

print("\n========== IVF ==========")

ivf = IVF(
    nlist=1024,
    nprobe=8,
)

ivf.build_index(
    base,
    train_vectors=train,
)

ivf_results = []


def ivf_timed_search(query):
    ids = ivf.search(query, k=10)
    ivf_results.append(ids)
    return ids


_, ivf_avg_time_sec = measure_query_time(
    ivf_timed_search,
    queries,
)

ivf_recall = compute_recall_at_k(
    ivf_results,
    ground_truth,
    k=10,
)

ivf_index_size = get_index_size(ivf)

print("IVF recall@10:      ", ivf_recall)
print("IVF avg query time: ", ivf_avg_time_sec * 1000, "ms")
print("IVF index size:     ", ivf_index_size, "MB")


# =================================================
# 3. IVF + PQ
# =================================================

print("\n========== IVF + PQ ==========")

ivfpq = IVFPQ(
    nlist=1024,
    nprobe=8,
    m=8,
    nbits=8,
)

ivfpq.build_index(
    base,
    train_vectors=train,
)

ivfpq_results = []


def ivfpq_timed_search(query):
    ids = ivfpq.search(query, k=10)
    ivfpq_results.append(ids)
    return ids


_, ivfpq_avg_time_sec = measure_query_time(
    ivfpq_timed_search,
    queries,
)

ivfpq_recall = compute_recall_at_k(
    ivfpq_results,
    ground_truth,
    k=10,
)

ivfpq_index_size = get_index_size(ivfpq)

print("IVF+PQ recall@10:      ", ivfpq_recall)
print("IVF+PQ avg query time: ", ivfpq_avg_time_sec * 1000, "ms")
print("IVF+PQ index size:     ", ivfpq_index_size, "MB")





# =================================================
# Final summary
# =================================================

print("\n========== SUMMARY ==========")

print(
    f"PQ     | recall@10={pq_recall:.3f} "
    f"| latency={pq_avg_time_sec * 1000:.3f} ms "
    f"| size={pq_index_size:.3f} MB"
)

print(
    f"IVF    | recall@10={ivf_recall:.3f} "
    f"| latency={ivf_avg_time_sec * 1000:.3f} ms "
    f"| size={ivf_index_size:.3f} MB"
)

print(
    f"IVF+PQ | recall@10={ivfpq_recall:.3f} "
    f"| latency={ivfpq_avg_time_sec * 1000:.3f} ms "
    f"| size={ivfpq_index_size:.3f} MB"
)

print("Note: the measured time technically includes a very small amount of Python overhead for appending the result to the list.
      "But the overhead is relatively small and the same benchmarking structures are used across PQ, IVF and IVF+PQ, hence the comparison is fair.")
